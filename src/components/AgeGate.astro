---
/**
 * Yaş kapısı — tam ekran taş doku zemin üzerinde krem kart.
 *
 * Kart zemini açık olduğu için logonun asıl (lacivert) sürümü kullanılır;
 * sitenin geri kalanındaki krem sürüm koyu zeminler içindir.
 *
 * Zemin fotoğrafı: public/images/yas-kapisi-zemin.jpeg
 * Dosya yoksa tüf tonlarında gradyana düşer, build kırılmaz.
 */
import fs from 'node:fs';
import { tr } from '../content/site';
import { withBase } from '../lib/url';
const t = tr.ageGate;

const zeminVar = fs.existsSync(`public${t.background}`);
---

<div
  id="age-gate"
  class:list={['age-gate', { 'age-gate--photo': zeminVar }]}
  style={zeminVar ? `--gate-bg: url('${withBase(t.background)}')` : undefined}
  role="dialog"
  aria-modal="true"
  aria-labelledby="age-gate-title"
>
  <div class="age-gate__card">
    <img
      class="age-gate__logo"
      src={withBase(t.logo)}
      alt={t.logoAlt}
      width="868"
      height="287"
      fetchpriority="high"
    />

    <div class="age-gate__body">
      {t.body.map((p) => <p>{p}</p>)}
    </div>

    <h1 id="age-gate-title" class="age-gate__prompt">{t.prompt}</h1>

    <div class="age-gate__actions">
      <a class="age-gate__btn age-gate__btn--ghost" href={t.noHref}>{t.no}</a>
      <span class="age-gate__sep" aria-hidden="true"></span>
      <button id="age-yes" class="age-gate__btn age-gate__btn--solid" type="button">
        {t.yes}
      </button>
    </div>

    <p class="age-gate__note">{t.note}</p>
  </div>
</div>

<style>
  .age-gate {
    /* Kart paleti — sitenin koyu zemin tokenlarından ayrı, tasarımdaki
       krem/lacivert/bordo değerleri. */
    --gate-card: #f5f1e9;
    --gate-ink: #2b2a3f;
    --gate-accent: #7b1e2f;

    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: clamp(16px, 4vw, 48px);
    text-align: center;
    /* Fotoğraf yoksa tüf tonlarında zemin */
    background:
      radial-gradient(120% 90% at 30% 20%, var(--color-tuff), transparent 70%),
      var(--color-tuff2);
  }

  .age-gate--photo {
    background-image: var(--gate-bg);
    background-size: cover;
    background-position: center;
  }

  .age-gate.is-hidden { display: none; }

  /* Ölçüler hem genişliğe hem yüksekliğe bağlı: dikey boşluklar vh ile
     verildiği için kısa ekranlarda kart kendiliğinden toparlanır ve
     iç kaydırma çubuğu çıkmaz. overflow-y yalnızca son çare. */
  .age-gate__card {
    width: min(760px, 100%);
    max-height: 100%;
    overflow-y: auto;
    box-sizing: border-box;
    padding: clamp(24px, 3.4vh, 44px) clamp(20px, 4vw, 56px);
    border-radius: clamp(10px, 1.2vw, 16px);
    background: var(--gate-card);
    color: var(--gate-ink);
    box-shadow: 0 18px 56px rgb(0 0 0 / 0.3);
    display: grid;
    justify-items: center;
    gap: clamp(14px, 2.2vh, 26px);
  }

  /* Genişlik üç sınırın en küçüğü; 39vh sınırı, oranı (3.024) gereği
     logonun yüksekliğini ~13vh'te tutar ki alçak ekranlarda taşmasın. */
  .age-gate__logo {
    display: block;
    width: min(300px, 22vw, 39vh);
    min-width: 150px;
    height: auto;
  }

  .age-gate__body {
    max-width: 52ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(14px, 1.15vw, 17px);
    line-height: 1.55;
  }

  .age-gate__body p { margin: 0; }
  .age-gate__body p + p { margin-top: 0.35em; }

  .age-gate__prompt {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(14px, 1.2vw, 18px);
    line-height: 1.3;
  }

  .age-gate__actions {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 2vw, 24px);
  }

  /* Butonlar arasındaki kısa çizgi */
  .age-gate__sep {
    flex: 0 0 auto;
    width: clamp(24px, 5vw, 72px);
    height: 1px;
    background: color-mix(in srgb, var(--gate-ink) 28%, transparent);
  }

  .age-gate__btn {
    flex: 1 1 0;
    max-width: 250px;
    box-sizing: border-box;
    padding: clamp(10px, 1.3vh, 15px) clamp(10px, 1.6vw, 20px);
    border-radius: 8px;
    font-family: var(--font-display);
    font-size: clamp(13px, 1.05vw, 16px);
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.35s ease, color 0.35s ease, border-color 0.35s ease;
  }

  .age-gate__btn--ghost {
    border: 1px solid color-mix(in srgb, var(--gate-accent) 55%, transparent);
    background: transparent;
    color: var(--gate-accent);
  }

  .age-gate__btn--ghost:hover {
    border-color: var(--gate-accent);
    background: color-mix(in srgb, var(--gate-accent) 7%, transparent);
  }

  .age-gate__btn--solid {
    border: 1px solid var(--gate-accent);
    background: var(--gate-accent);
    color: var(--gate-card);
  }

  .age-gate__btn--solid:hover {
    background: color-mix(in srgb, var(--gate-accent) 86%, #000);
    border-color: color-mix(in srgb, var(--gate-accent) 86%, #000);
  }

  .age-gate :global(:focus-visible) {
    outline: 2px solid var(--gate-accent);
    outline-offset: 3px;
  }

  .age-gate__note {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(12px, 1vw, 15px);
  }

  /* Dar ekranda butonlar alt alta; aradaki çizgi yatayda anlamını yitirir */
  @media (max-width: 560px) {
    .age-gate__actions { flex-direction: column; }
    .age-gate__btn { width: 100%; max-width: none; flex: 0 0 auto; }
    .age-gate__sep { width: 72px; }
  }

  /* Kapı açıkken sayfa kaydırılamaz */
  :global(body.gated) { overflow: hidden; }
</style>

<script>
  // Onay yalnızca tarayıcı oturumu boyunca hatırlanır (sessionStorage) —
  // sayfalar arası gezinmede tekrar sorulmaz, yeni oturumda yeniden sorulur.
  // Oturumlar arası kalıcılık istenirse çerez kullanılabilir (KVKK/çerez
  // politikasına eklenmek koşuluyla).
  import { YAS_ONAY_KEY, yasOnayiVar } from '../lib/yas-kapisi';

  const gate = document.getElementById('age-gate');
  const yes = document.getElementById('age-yes');

  if (yasOnayiVar()) {
    gate?.classList.add('is-hidden');
  } else {
    document.body.classList.add('gated');
  }

  yes?.addEventListener('click', () => {
    sessionStorage.setItem(YAS_ONAY_KEY, '1');
    gate?.classList.add('is-hidden');
    document.body.classList.remove('gated');
    document.dispatchEvent(new CustomEvent('agegate:confirmed'));
    // Yükleme ekranını tetikler — overlay kapandıktan sonra, en sonda.
    document.dispatchEvent(new CustomEvent('agegate:accepted'));
  });
</script>
