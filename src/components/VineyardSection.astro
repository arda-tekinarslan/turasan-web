---
/**
 * Bağcılık (açık bölüm) — üstte bölge haritası görseli, terroir metni,
 * üzüm kartları ve "Üzümler ve bölgeler →" linki.
 * Üst boşluk, Miras bölümünden taşan portreye yer açacak kadar geniştir.
 *
 * Harita statik bir görseldir (el çizimi): public/images/terroir.jpeg
 * Dosya yoksa etiketli yer tutucu görünür, build kırılmaz.
 */
import fs from 'node:fs';
import { tr } from '../content/site';
import GrapeCard from './GrapeCard.astro';
import { withBase } from '../lib/url';
const t = tr.vineyard;

const HARITA = '/images/terroir.jpeg';
const haritaVar = fs.existsSync(`public${HARITA}`);

// Görsel metin içerdiği için alt, aynı bilgiyi eksiksiz aktarır.
const haritaAlt =
  'Türkiye haritası üzerinde bağ bölgeleri ve üzümleri: ' +
  'Kapadokya/Nevşehir — Emir, Kalecik Karası, Öküzgözü, Riesling; ' +
  'Denizli/Güney — Sauvignon Blanc, Chardonnay, Misket, Boğazkere, ' +
  'Cabernet Sauvignon, Cabernet Franc, Kalecik Karası, Merlot, Syrah; ' +
  'İzmir/Menderes — Misket; Tokat — Narince; Elazığ — Öküzgözü.';
---

<section id={t.id} class="section theme-light vineyard" data-descent="Bağcılık">
  <div class="container">
    <div class="vineyard__head reveal">
      <p class="overline">{t.overline}</p>
      <h2 class="display">{t.title}</h2>
    </div>

    <figure class="vineyard__map reveal">
      {haritaVar ? (
        <img
          class="vineyard__map-img"
          src={withBase(HARITA)}
          alt={haritaAlt}
          width="1254"
          height="1254"
          loading="lazy"
        />
      ) : (
        <div class="ph vineyard__map-ph">
          <span class="ph__label">görsel · bölge haritası — public/images/terroir.jpeg</span>
        </div>
      )}
    </figure>

    <div class="vineyard__body prose-block lead muted">
      {t.body.map((p, i) => (
        <p class="reveal" style={`transition-delay: ${i * 80}ms;`}>{p}</p>
      ))}
    </div>

    <div class="vineyard__grapes">
      {t.grapes.map((g, i) => (
        <div class="reveal" style={`transition-delay: ${i * 80}ms;`}>
          <GrapeCard {...g} href={withBase(g.href)} />
        </div>
      ))}
    </div>

    <p class="reveal" style="margin-top: 2.4em;">
      <a class="cta" href={withBase(t.cta.href)}>
        {t.cta.label} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<style>
  /* Zemin, harita görselinin kâğıt rengiyle birebir aynı — görselin kendi
     kremi bölüme karışır, kenarı belli olmaz. Bölüm iki koyu bölümün
     (Miras ve Üretim) arasında olduğu için komşularıyla dikiş oluşmaz. */
  .vineyard {
    background: var(--color-paper);
  }

  .vineyard__head { max-width: 62ch; }

  /* Görsel kare (1254×1254) ama çizim y 240–1128 bandında duruyor; üstte
     %19, altta %10 boşluk var. Pencereyi y 200–1170 aralığına kırpıyoruz:
     çizim üstte ve altta ~40px payla tamamen görünür, gereksiz dikey
     boşluk gider. Görsel değişirse bu iki değer yeniden ölçülmeli. */
  .vineyard__map {
    margin: clamp(36px, 6vh, 64px) auto 0;
    max-width: 880px;
    aspect-ratio: 1254 / 970;
    overflow: hidden;
  }

  .vineyard__map-img {
    display: block;
    width: 100%;
    height: auto;
    /* Kırpma payı: görselin üst %15,9'u pencerenin dışında kalır */
    margin-top: -15.9%;
  }

  /* Yer tutucu kırpılmaz; kendi oranında durur */
  .vineyard__map:has(.vineyard__map-ph) {
    aspect-ratio: auto;
    overflow: visible;
  }

  .vineyard__map-ph {
    aspect-ratio: 16 / 9;
    width: 100%;
  }

  .vineyard__body {
    margin-top: clamp(36px, 6vh, 64px);
    max-width: 58ch;
  }

  .vineyard__grapes {
    margin-top: clamp(40px, 7vh, 72px);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(16px, 2.5vw, 28px);
  }

  /* Aynı satırdaki kartlar eşit yükseklikte dursun. Sarmalayıcılar grid
     tarafından zaten geriliyordu; kartın da sarmalayıcıyı doldurması için
     onu grid öğesi yapıyoruz. Aksi hâlde açıklaması tek satıra sığan kart
     (ör. Öküzgözü) komşusundan kısa kalıyor. */
  .vineyard__grapes > * {
    display: grid;
  }

  @media (max-width: 760px) {
    .vineyard__grapes { grid-template-columns: 1fr; }
  }
</style>
