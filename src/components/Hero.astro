---
import fs from 'node:fs';
import { tr } from '../content/site';
import { withBase } from '../lib/url';
const t = tr.hero;

// Dosya yoksa slayt, etiketli yer tutucu olarak kalır (build kırılmaz).
const gorselVar = (yol: string) => fs.existsSync(`public${yol}`);
---

<section id="top" class="hero theme-dark" data-descent="Giriş">
  <!--
    Slayt katmanı — dekoratif (aria-hidden). Her yer tutucu panel, gerçek
    fotoğraf geldiğinde <img fetchpriority="high" ...> (ilk slayt) ve
    lazy-load <img> (diğerleri) ile değişecek.
  -->
  <div class="hero__slides" aria-hidden="true">
    {t.slides.map((s, i) => (
      <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide={i}>
        {gorselVar(s.image) ? (
          <img
            class="hero__slide-img"
            src={withBase(s.image)}
            alt=""
            width="2400"
            height="1600"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async"
          />
        ) : (
          <span class="ph__label hero__slide-label">{s.label} — public{s.image}</span>
        )}
      </div>
    ))}
  </div>

  <!-- Metnin okunması için alttan yukarı ince koyu gradyan -->
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__content container">
    <!--
      Basılı logonun koyu zemin sürümü. Kaynak dosya lacivert/kırmızı
      (public/images/logo.png); mahzen koyusunda okunmadığı için renkleri
      krem ve altına çevrilmiş kopyası kullanılır. İkisi de depoda durur:
      lacivert olan açık zeminli ve basılı kullanımlar için.
      Ekranın ilk karesinde göründüğü için lazy-load yok.
    -->
    <h1 class="hero__logo">
      <img
        class="hero__logo-img"
        src={withBase('/images/logo-koyu-zemin.png')}
        alt={`${t.logo.name} ${t.logo.year}`}
        width="868"
        height="287"
        fetchpriority="high"
      />
    </h1>
    <p class="lead hero__sub">{t.sub}</p>
  </div>

  <a id="hero-scroll" class="hero__scroll" href="#miras" aria-label={t.scroll}>
    <span class="hero__scroll-label">{t.scroll}</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>

  <span id="hero-sentinel" class="hero__sentinel" aria-hidden="true"></span>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-content: start;
    padding-top: clamp(120px, 22vh, 240px);
    overflow: hidden;
  }

  .hero__slides {
    position: absolute;
    inset: 0;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero__slide.is-active {
    opacity: 1;
    animation: hero-zoom 7.2s linear forwards;
  }

  @keyframes hero-zoom {
    from { transform: scale(1); }
    to { transform: scale(1.06); }
  }

  /* Fotoğraf yerine geçici atmosfer — her slayt hafifçe farklı bir ton alır
     ki cross-fade prototipte de algılansın. */
  .hero__slide {
    background:
      radial-gradient(90% 60% at 50% 100%, color-mix(in srgb, var(--color-ochre) 14%, transparent), transparent 70%),
      linear-gradient(180deg, var(--color-cave) 0%, var(--color-ink) 78%, var(--color-cave) 100%);
  }
  .hero__slide[data-slide='1'] {
    background:
      radial-gradient(90% 60% at 30% 90%, color-mix(in srgb, var(--color-garnet) 16%, transparent), transparent 70%),
      linear-gradient(180deg, var(--color-cave) 0%, var(--color-ink) 78%, var(--color-cave) 100%);
  }
  .hero__slide[data-slide='2'] {
    background:
      radial-gradient(110% 70% at 70% 100%, color-mix(in srgb, var(--color-tuff2) 10%, transparent), transparent 72%),
      linear-gradient(180deg, var(--color-ink) 0%, var(--color-cave) 85%);
  }
  .hero__slide[data-slide='3'] {
    background:
      radial-gradient(80% 55% at 50% 80%, color-mix(in srgb, var(--color-ochre) 20%, transparent), transparent 68%),
      linear-gradient(180deg, var(--color-cave) 10%, var(--color-ink) 90%);
  }
  .hero__slide[data-slide='4'] {
    background:
      radial-gradient(100% 65% at 45% 95%, color-mix(in srgb, var(--color-garnet) 10%, var(--color-ochre) 6%), transparent 70%),
      linear-gradient(180deg, var(--color-ink) 0%, var(--color-cave) 80%);
  }
  .hero__slide[data-slide='5'] {
    background:
      radial-gradient(95% 60% at 60% 90%, color-mix(in srgb, var(--color-ochre) 16%, transparent), transparent 70%),
      linear-gradient(180deg, var(--color-cave) 0%, var(--color-ink) 70%, var(--color-cave) 100%);
  }
  .hero__slide[data-slide='6'] {
    background:
      radial-gradient(105% 65% at 40% 100%, color-mix(in srgb, var(--color-garnet) 14%, transparent), transparent 72%),
      linear-gradient(180deg, var(--color-ink) 0%, var(--color-cave) 88%);
  }

  /* Fotoğraf slaytı kaplar; zoom animasyonu slayta uygulandığı için
     görsel de onunla birlikte büyür. İlk slayt ekranın ilk karesinde
     göründüğü için eager + fetchpriority=high, diğerleri lazy. */
  .hero__slide-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__slide-label {
    position: absolute;
    right: var(--gutter);
    bottom: 20px;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-cave) 45%, transparent) 0%,
      transparent 30%,
      transparent 55%,
      color-mix(in srgb, var(--color-cave) 82%, transparent) 100%
    );
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    width: 100%;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  .hero__logo {
    margin: 0;
    line-height: 0;
  }

  /* Genişlik viewport'a bağlı; yükseklik görselin kendi oranından (868×287)
     gelir. width/height nitelikleri de bu oranı taşır, böylece görsel
     yüklenirken hero'daki metin yer değiştirmez. */
  .hero__logo-img {
    display: block;
    width: clamp(240px, 44vw, 540px);
    height: auto;
  }

  .hero__sub {
    margin-top: 8px;
    max-width: 46ch;
    color: var(--color-on-dark-mut);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 10px;
    text-decoration: none;
    transition: opacity 0.7s ease;
  }

  .hero__scroll.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .hero__scroll-label {
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-on-dark-mut);
  }

  .hero__scroll-line {
    width: 1px;
    height: 44px;
    background: var(--color-on-dark-mut);
    transform-origin: top;
    animation: pulse 2.6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scaleY(0.45); opacity: 0.5; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  .hero__sentinel {
    position: absolute;
    bottom: 0;
    width: 1px;
    height: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide.is-active { animation: none; }
    .hero__scroll-line { animation: none; }
  }
</style>

<script>
  // Hero slaytı: ~6 sn ekranda, 1.2 sn cross-fade, sonsuz döngü, kontrol yok.
  // Hareket azaltma tercihi varsa ilk görsel sabit kalır.
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero__slide'));

  if (!prefersReduced && slides.length > 1) {
    let current = 0;
    setInterval(() => {
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
    }, 6000);
  }

  // "Kaydırın" işareti ilk scroll'da kaybolur.
  const cue = document.getElementById('hero-scroll');
  if (cue) {
    const hide = () => {
      if (window.scrollY > 40) {
        cue.classList.add('is-hidden');
        window.removeEventListener('scroll', hide);
      }
    };
    window.addEventListener('scroll', hide, { passive: true });
  }
</script>
