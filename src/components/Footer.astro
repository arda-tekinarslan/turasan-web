---
import { dilBul, icerik, yol, karsiDilYolu } from '../lib/dil';
import SocialLinks from './SocialLinks.astro';
import YasalMetinler from './YasalMetinler.astro';
const lang = dilBul(Astro.url);
const t = icerik(lang).footer;
// Her iki dil bağlantısı da bulunulan sayfanın o dildeki karşılığına gider
const burasi = Astro.url.pathname;
const trHref = lang === 'tr' ? burasi : karsiDilYolu(Astro.url);
const enHref = lang === 'en' ? burasi : karsiDilYolu(Astro.url);
---

<footer class="site-footer theme-dark">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand-col">
        <p class="display site-footer__brand">Turasan</p>
        <p class="muted site-footer__about">{t.about}</p>
        <!-- Sarmalayıcı şart: konum stilleri Footer'ın scope'unda tanımlı,
             SocialLinks'in kendi ürettiği <ul> o scope'u taşımaz. -->
        <div class="site-footer__social">
          <SocialLinks size={36} />
        </div>
      </div>

      {t.columns.map((col) => (
        <nav aria-label={col.title}>
          <p class="overline site-footer__col-title">{col.title}</p>
          <ul class="site-footer__links">
            {col.links.map((l) => (
              <li>
                {'modal' in l ? (
                  <button class="site-footer__modal-btn" type="button" data-modal-ac={l.modal}>
                    {l.label}
                  </button>
                ) : (
                  <a href={yol(lang, l.href)}>{l.label}</a>
                )}
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <div>
        <p class="overline site-footer__col-title">{t.langTitle}</p>
        <p class="site-footer__lang">
          <a href={trHref} hreflang="tr" lang="tr" aria-current={lang === 'tr' ? 'true' : undefined} data-dil-gecis>TR</a>
          <span class="muted"> / </span>
          <a href={enHref} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined} data-dil-gecis>EN</a>
        </p>
      </div>
    </div>

    <p class="muted site-footer__legal">{t.legal}</p>
  </div>

  <!-- Kurumsal pencereler — footer'daki butonlar bunları açar -->
  <YasalMetinler />
</footer>

<style>
  .site-footer {
    padding-block: clamp(56px, 9vh, 96px) 32px;
    border-top: 1px solid color-mix(in srgb, var(--color-on-dark) 10%, transparent);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--split-gap);
  }

  .site-footer__brand {
    font-size: 30px;
    margin: 0 0 10px;
  }

  .site-footer__about {
    font-size: 14px;
    max-width: 30ch;
  }

  /* Marka sütunu, komşu bağlantı sütunlarından kısa kalıyor; simgeleri
     sütunun dibine yaslayarak o boşluğu kapatır ve son footer bağlantısıyla
     aynı hizaya getiririz. padding-top, metne yapışmasını engelleyen taban. */
  .site-footer__brand-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .site-footer__social {
    margin-top: auto;
    padding-top: 32px;
  }

  .site-footer__col-title {
    font-size: 11px;
    margin-bottom: 16px;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .site-footer__links a {
    font-size: 14px;
    color: var(--color-on-dark);
    text-decoration: none;
  }

  .site-footer__links a:hover {
    color: var(--color-ochre);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Pencere açan öğeler buton; komşu linklerle birebir aynı görünür */
  .site-footer__modal-btn {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    color: var(--color-on-dark);
    text-align: left;
    cursor: pointer;
  }

  .site-footer__modal-btn:hover {
    color: var(--color-ochre);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-footer__lang { font-size: 14px; }

  .site-footer__lang a {
    color: var(--color-on-dark-mut);
    text-decoration: none;
  }

  .site-footer__lang a[aria-current='true'] { color: var(--color-on-dark); }
  .site-footer__lang a:hover { color: var(--color-ochre); }

  .site-footer__legal {
    margin-top: clamp(40px, 7vh, 64px);
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb, var(--color-on-dark) 10%, transparent);
    font-size: 13px;
  }

  @media (max-width: 760px) {
    .site-footer__grid { grid-template-columns: 1fr 1fr; gap: 36px; }
  }
</style>
