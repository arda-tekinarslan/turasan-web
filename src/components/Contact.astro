---
/**
 * İletişim / Konum (açık bölüm) — en üstte çok büyük puntoyla şehir başlığı,
 * altında sade bilgi listesi ve gömülü harita yer tutucusu (lazy-load).
 */
import { dilBul, icerik, yol } from '../lib/dil';
import SocialLinks from './SocialLinks.astro';
const lang = dilBul(Astro.url);
const c = icerik(lang);
const t = c.contact;
---

<section id={t.id} class="section theme-light" data-descent={t.descent}>
  <div class="container">
    <p class="overline reveal">{t.overline}</p>
    <h2 class="display contact__city reveal" style="transition-delay: 80ms;">
      {t.city} <span class="contact__city-sep" aria-hidden="true">/</span> {t.region}
    </h2>

    <div class="contact__grid">
      <!-- Bilgi listesi ve şubeler bağlantısı tek sütun; grid iki çocuk görür -->
      <div class="contact__col reveal">
      <dl class="contact__list">
        <div class="contact__item">
          <dt class="overline contact__label">{t.labels.address}</dt>
          <dd>{t.address}</dd>
        </div>
        <div class="contact__item">
          <dt class="overline contact__label">{t.labels.email}</dt>
          <dd><a class="contact__link" href={`mailto:${t.email}`}>{t.email}</a></dd>
        </div>
        <div class="contact__item">
          <dt class="overline contact__label">{t.labels.phone}</dt>
          <dd><a class="contact__link" href={`tel:${t.phoneDial}`}>{t.phone}</a></dd>
        </div>
        <div class="contact__item">
          <dt class="overline contact__label">{t.labels.location}</dt>
          <dd>
            <a class="contact__link" href={t.mapCta.href} target="_blank" rel="noopener">
              {t.mapCta.label} <span aria-hidden="true">→</span>
            </a>
          </dd>
        </div>
        <div class="contact__item">
          <dt class="overline contact__label">{t.hoursTitle}</dt>
          <dd>
            {t.hours.map((h) => (
              <span class="contact__hours-row">{h.label}: {h.value}</span>
            ))}
          </dd>
        </div>
        <div class="contact__item">
          <dt class="overline contact__label">{c.social.title}</dt>
          <dd><SocialLinks size={32} /></dd>
        </div>
      </dl>

      <p class="contact__branches">
        <a class="cta" href={yol(lang, t.branchesCta.href)}>
          {t.branchesCta.label} <span class="arrow" aria-hidden="true">→</span>
        </a>
      </p>
      </div>

      <div class="reveal" style="transition-delay: 80ms;">
        <!--
          Gömülü Google Haritalar. iframe yüklendiği anda Google çerezleri
          devreye girebildiği için, çerez tercihlerinde "Pazarlama ve İşlevsel
          Çerezler" açık değilse önce bir perde gösterilir; ziyaretçi
          "Haritayı göster" derse yüklenir. Tercih açıksa doğrudan yüklenir.
        -->
        <div class="contact__map" data-harita data-src={t.mapEmbed} data-baslik={t.mapTitle}>
          <div class="harita__perde" data-harita-perde>
            <p class="overline harita__baslik">{t.mapPerde.baslik}</p>
            <p class="harita__metin">{t.mapPerde.metin}</p>
            <button class="harita__buton" type="button" data-harita-yukle>
              {t.mapPerde.buton}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__city {
    font-size: clamp(48px, 10vw, 120px);
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 0.35em;
  }

  .contact__city-sep { color: var(--color-on-light-mut); }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--split-gap);
    align-items: start;
    margin-top: clamp(40px, 7vh, 72px);
  }

  .contact__map {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 30% 20%, var(--color-tuff2), transparent 70%),
      var(--color-tuff);
    border: 1px solid color-mix(in srgb, var(--color-on-light) 14%, transparent);
  }

  /* iframe script ile eklendiği için scope özniteliği taşımaz; :global şart */
  .contact__map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .harita__perde {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    padding: 24px;
    text-align: center;
  }

  .harita__baslik { margin: 0; font-size: 11px; }

  .harita__metin {
    margin: 0;
    max-width: 34ch;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-on-light-mut);
  }

  .harita__buton {
    margin-top: 6px;
    padding: 10px 22px;
    border: 1px solid var(--color-garnet);
    border-radius: 8px;
    background: transparent;
    color: var(--color-garnet);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.35s ease, color 0.35s ease;
  }

  .harita__buton:hover {
    background: var(--color-garnet);
    color: var(--color-tuff);
  }

  .contact__list {
    margin: 0;
    display: grid;
    gap: 22px;
  }

  .contact__branches { margin: 28px 0 0; }

  .contact__label { font-size: 11px; }

  .contact__item dd {
    margin: 6px 0 0;
    color: var(--color-on-light-mut);
  }

  .contact__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .contact__link:hover { color: var(--color-garnet); }

  .contact__hours-row { display: block; }

  @media (max-width: 760px) {
    .contact__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { cerezTercihiOku, CEREZ_OLAY } from '../lib/cerez-tercihi';

  const kutu = document.querySelector<HTMLElement>('[data-harita]');

  /** İşlevsel çerezlere izin verilmiş mi? ("Pazarlama ve İşlevsel Çerezler") */
  const izinVar = () => cerezTercihiOku()?.pazarlama === true;

  function haritayiYukle() {
    if (!kutu || kutu.dataset.yuklendi) return;
    kutu.dataset.yuklendi = '1';

    const f = document.createElement('iframe');
    f.src = kutu.dataset.src ?? '';
    f.title = kutu.dataset.baslik ?? 'Harita';
    f.loading = 'lazy';
    f.referrerPolicy = 'no-referrer-when-downgrade';
    f.allowFullscreen = true;

    kutu.querySelector('[data-harita-perde]')?.remove();
    kutu.appendChild(f);
  }

  if (kutu) {
    if (izinVar()) haritayiYukle();
    kutu.querySelector('[data-harita-yukle]')?.addEventListener('click', haritayiYukle);
    // Tercih aynı sayfada kaydedilirse sayfa yenilemeden uygulanır
    document.addEventListener(CEREZ_OLAY, () => {
      if (izinVar()) haritayiYukle();
    });
  }
</script>
