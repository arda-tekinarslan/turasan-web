---
import { tr } from '../content/site';
const t = tr.products;
---

<section id={t.id} class="section theme-dark" data-descent="Ürünler">
  <div class="container">
    <div class="products__head reveal">
      <p class="overline">{t.overline}</p>
      <h2 class="display">{t.title}</h2>
      <p class="muted products__note">{t.note}</p>
    </div>

    <ul class="products__list reveal">
      {t.items.map((item) => (
        <li class="products__row">
          <span class="display products__grape">{item.grape}</span>
          <span class="products__type">{item.type}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .products__head { max-width: 62ch; }

  .products__note {
    margin-top: 1.4em;
    font-size: 14px;
    max-width: 58ch;
  }

  .products__list {
    list-style: none;
    margin: clamp(36px, 6vh, 56px) 0 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-on-dark) 14%, transparent);
  }

  .products__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(18px, 3vh, 28px) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-on-dark) 14%, transparent);
  }

  .products__grape {
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.1;
  }

  .products__type {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-on-dark-mut);
  }
</style>
