---
import { tr } from '../content/site';
const t = tr.terroir;
---

<section id={t.id} class="section theme-dark" data-descent="Terroir">
  <div class="container">
    <div class="terroir__head reveal">
      <p class="overline">{t.overline}</p>
      <h2 class="display">{t.title}</h2>
      <div class="prose-block lead muted" style="margin-top: 1.2em;">
        {t.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>

  <div class="terroir__band reveal">
    <div class="ph ph--band">
      <span class="ph__label">{t.phLabel}</span>
    </div>
  </div>

  <div class="container">
    <dl class="terroir__facts reveal">
      {t.facts.map((f) => (
        <div class="terroir__fact">
          <dt class="overline terroir__fact-label">{f.label}</dt>
          <dd class="display terroir__fact-value">{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .terroir__head { max-width: 62ch; }

  .terroir__band {
    margin-block: clamp(40px, 7vh, 72px);
  }

  .terroir__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--split-gap);
    margin: 0;
    padding-top: 8px;
    border-top: 1px solid color-mix(in srgb, var(--color-on-dark) 14%, transparent);
  }

  .terroir__fact { padding-top: 20px; }

  .terroir__fact-label { font-size: 11px; }

  .terroir__fact-value {
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.2;
    margin: 10px 0 0;
  }

  @media (max-width: 760px) {
    .terroir__facts { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
