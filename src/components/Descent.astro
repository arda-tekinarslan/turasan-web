---
/**
 * İmza öğe — "mahzene iniş".
 * Sol kenarda dikey nokta dizisi; sayfa aşağı indikçe (mahzene inildikçe)
 * noktalar dolar. data-descent-target ile bölümler otomatik bağlanır.
 */
---

<nav id="descent" class="descent" aria-label="Sayfa bölümleri"></nav>

<style>
  .descent {
    position: fixed;
    left: clamp(10px, 2vw, 24px);
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .descent.visible { opacity: 1; }

  .descent :global(a) {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: transparent;
    transition: background 0.4s ease, transform 0.4s ease;
  }

  /* Renk, o anki bölümün temasına göre karışır — sabit gri yerine
     taş/mahzen tonlarında kalır */
  .descent[data-on='dark'] { color: var(--color-on-dark-mut); }
  .descent[data-on='light'] { color: var(--color-on-light-mut); }

  /* İnilen (geçilen + aktif) noktalar dolu */
  .descent :global(a.filled) { background: currentColor; }
  .descent :global(a.active) { transform: scale(1.45); }

  @media (max-width: 760px) {
    .descent { display: none; }
  }
</style>

<script>
  const nav = document.getElementById('descent');
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>('[data-descent]')
  );

  if (nav && sections.length) {
    const dots = sections.map((s, i) => {
      const a = document.createElement('a');
      a.href = `#${s.id}`;
      a.setAttribute('aria-label', s.dataset.descent || `Bölüm ${i + 1}`);
      nav.appendChild(a);
      return a;
    });

    let current = 0;
    const paint = () => {
      dots.forEach((d, i) => {
        d.classList.toggle('filled', i <= current);
        d.classList.toggle('active', i === current);
      });
      const theme = sections[current].classList.contains('theme-dark')
        ? 'dark'
        : 'light';
      nav.dataset.on = theme;
      nav.classList.toggle('visible', current > 0);
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            current = sections.indexOf(e.target as HTMLElement);
            paint();
          }
        });
      },
      { rootMargin: '-45% 0px -45% 0px' }
    );

    sections.forEach((s) => io.observe(s));
    paint();
  }
</script>
