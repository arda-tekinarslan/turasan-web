---
import { tr } from '../content/site';
---

<section id="manifesto" class="section theme-dark manifesto" data-descent="Manifesto">
  <div class="container">
    <p class="display manifesto__line reveal">{tr.manifesto}</p>
  </div>
</section>

<style>
  .manifesto { text-align: center; }

  .manifesto__line {
    font-size: clamp(26px, 3.6vw, 44px);
    line-height: 1.25;
    max-width: 26ch;
    margin-inline: auto;
  }
</style>
