---
/**
 * Sosyal medya bağlantıları — İletişim bölümü ve footer aynı bileşeni kullanır.
 *
 * Simgeler currentColor ile çizilir; bulunduğu bölümün metin rengini alır,
 * hover'da açık bölümde garnet, koyu bölümde ochre olur (sitedeki .cta ile
 * aynı davranış). Adresler ve etiketler src/content/site.ts içinde.
 */
import { dilBul, icerik } from '../lib/dil';

interface Props {
  /** Simge kenar uzunluğu (px). Footer'da biraz küçük kullanılır. */
  size?: number;
}

const { size = 22 } = Astro.props;
const t = icerik(dilBul(Astro.url)).social;

/*
 * Konumlandırma bilinçli olarak dışarıda: bu bileşenin ürettiği <ul>,
 * kullanan sayfanın scoped stiline görünmez. Yerleşim için bileşeni bir
 * sarmalayıcının içine koyup o sarmalayıcıyı biçimlendirin.
 */
---

<ul class="social" style={`--social-size: ${size}px;`}>
  {t.links.map((l) => (
    <li>
      <a
        class="social__link"
        href={l.href}
        aria-label={l.label}
        target={l.href.startsWith('#') ? undefined : '_blank'}
        rel={l.href.startsWith('#') ? undefined : 'noopener'}
      >
        {l.icon === 'instagram' && (
          <svg
            class="social__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5.4" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.5" cy="6.6" r="1.05" fill="currentColor" stroke="none" />
          </svg>
        )}

        {l.icon === 'linkedin' && (
          <svg
            class="social__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2.6" y="2.6" width="18.8" height="18.8" rx="4.6" />
            <circle cx="7.4" cy="7.7" r="0.95" fill="currentColor" stroke="none" />
            <path d="M7.4 10.9v6.4" />
            <path d="M11.7 17.3v-6.4" />
            <path d="M11.7 13.7a2.65 2.65 0 0 1 5.3 0v3.6" />
          </svg>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    /* Aralık simge boyutuyla birlikte büyür — size değişince elle ayar gerekmez */
    gap: calc(var(--social-size) * 0.55);
  }

  .social__link {
    display: grid;
    place-items: center;
    color: inherit;
    text-decoration: none;
    transition: color 0.35s ease, transform 0.35s ease;
  }

  .social__icon {
    display: block;
    width: var(--social-size);
    height: var(--social-size);
  }

  /* Açık bölümde garnet, koyu bölümde ochre — .cta ile aynı kural */
  .social__link:hover {
    color: var(--color-garnet);
    transform: translateY(-2px);
  }

  :global(.theme-dark) .social__link:hover {
    color: var(--color-ochre);
  }

  @media (prefers-reduced-motion: reduce) {
    .social__link { transition: color 0.35s ease; }
    .social__link:hover { transform: none; }
  }
</style>
