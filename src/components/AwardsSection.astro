---
/**
 * Ödüller (açık bölüm) — kurumsal-nesnel ton; veriler src/content/awards.ts
 * dosyasından gelir, yalnızca FEATURED_YEAR yılına ait ödüller gösterilir.
 *
 * Logo: her kartta sabit kare (1:1) alan. public/images/oduller/{slug}.png
 * dosyası varsa <img> render edilir (her zaman renkli, hover'da hafifçe
 * büyür); yoksa aynı boyutta nötr boş kutu kalır — layout kaymaz, hata
 * oluşmaz.
 */
import fs from 'node:fs';
import { awards, FEATURED_YEAR } from '../content/awards';
import { withBase } from '../lib/url';

const featured = awards.filter((a) => a.year === FEATURED_YEAR);
const logoExists = (logo: string) => fs.existsSync(`public${logo}`);

const title = `${FEATURED_YEAR} değerlendirmeleri`;
const intro =
  `Aşağıda, kurumumuzun ${FEATURED_YEAR} yılında katıldığı uluslararası ` +
  'yarışmalarda aldığı sonuçlar; yarışma, şarap ve derece düzeyinde listelenir.';
---

<section id="oduller" class="section theme-light" data-descent="Ödüller">
  <div class="container">
    <div class="awards__head reveal">
      <p class="overline">Ödüller</p>
      <h2 class="display">{title}</h2>
      <p class="lead muted" style="margin-top: 1.2em;">{intro}</p>
    </div>

    <ul class="awards__row">
      {featured.map((a, i) => (
        <li class="awards__item reveal" style={`transition-delay: ${i * 80}ms;`}>
          <span class="awards__logo" aria-hidden="true">
            {logoExists(a.logo) ? (
              <img src={withBase(a.logo)} alt="" width="288" height="288" loading="lazy" />
            ) : (
              <span class="awards__logo-empty"></span>
            )}
          </span>
          <span class="awards__text">
            <span class="awards__comp">{a.competition}</span>
            {a.wine} <span class="awards__sep">·</span> {a.medal}
          </span>
        </li>
      ))}
    </ul>

    <p class="reveal" style="margin-top: 2.4em;">
      <a class="cta" href={withBase('/oduller')}>
        Tüm Ödüller <span class="arrow" aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<style>
  .awards__head { max-width: 62ch; }

  .awards__row {
    list-style: none;
    margin: clamp(40px, 7vh, 64px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 260px));
    gap: clamp(20px, 3vw, 40px);
  }

  .awards__item {
    display: grid;
    justify-items: center;
    gap: 14px;
    text-align: center;
    padding-top: 20px;
    border-top: 1px solid color-mix(in srgb, var(--color-on-light) 14%, transparent);
  }

  /* Sabit kare logo alanı — dosya olsun olmasın aynı yer kaplar.
     Görseller 288×288 kare tuvalde, madalya tuvalin %88'i ve ortalanmış
     olarak hazırlanır; böylece farklı yarışma logoları aynı boyutta durur. */
  .awards__logo {
    width: clamp(104px, 12vw, 136px);
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
  }

  .awards__logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  /* Madalya her zaman renkli durur; hover yalnızca hafif bir büyütme yapar.
     Tuval payı %12 olduğu için büyüme kutunun dışına taşmaz. */
  .awards__item:hover .awards__logo img {
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .awards__logo img { transition: none; }
    .awards__item:hover .awards__logo img { transform: none; }
  }

  /* Logo henüz eklenmediyse: nötr boş kutu */
  .awards__logo-empty {
    width: 100%;
    height: 100%;
    background: var(--color-tuff2);
  }

  .awards__text {
    font-size: 14px;
    color: var(--color-on-light);
    line-height: 1.5;
  }

  .awards__comp {
    display: block;
    font-weight: 500;
    margin-bottom: 2px;
  }

  .awards__sep { color: var(--color-on-light-mut); }

  @media (max-width: 760px) {
    .awards__row { grid-template-columns: 1fr 1fr; }
  }
</style>
