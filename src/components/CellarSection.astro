---
/**
 * Mahzen (taş/tuff bölüm) — kaya mahzen fotoğrafı, kısa tanıtım ve
 * detay sayfasına link. Ton nesnel; davet/özendirme dili kullanılmaz.
 *
 * Fotoğraf: public/images/mahzen/mahzen-koridor.jpeg (yol site.ts'te).
 * Dosya yoksa etiketli yer tutucu görünür, build kırılmaz.
 */
import fs from 'node:fs';
import { dilBul, icerik, yol } from '../lib/dil';
import { withBase } from '../lib/url';
const lang = dilBul(Astro.url);
const t = icerik(lang).cellar;

const gorselVar = fs.existsSync(`public${t.image}`);
---

<section id={t.id} class="section theme-light cellar" data-descent={t.overline}>
  <div class="container">
    <div class="split">
      <div class="split__media reveal">
        {gorselVar ? (
          <img
            class="cellar__img"
            src={withBase(t.image)}
            alt={t.imageAlt}
            width="1600"
            height="2000"
            loading="lazy"
          />
        ) : (
          <div class="ph ph--portrait">
            <span class="ph__label">{t.phLabel}</span>
          </div>
        )}
      </div>

      <div class="split__text reveal" style="transition-delay: 80ms;">
        <p class="overline">{t.overline}</p>
        <h2 class="display">{t.title}</h2>
        <div class="prose-block lead muted" style="margin-top: 1.2em;">
          {t.body.map((p) => <p>{p}</p>)}
        </div>

        <p style="margin-top: 2em;">
          <a class="cta" href={yol(lang, t.cta.href)}>
            {t.cta.label} <span class="arrow" aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Taş zemin — açık bölümlerden bir ton derin */
  .cellar { background: var(--color-tuff2); }

  /* Yer tutucu, tuff-2 zeminden ayrışsın */
  .cellar :global(.ph) {
    background:
      radial-gradient(120% 90% at 30% 20%, var(--color-tuff), transparent 70%),
      color-mix(in srgb, var(--color-tuff) 60%, var(--color-tuff2));
  }

  /* Yer tutucuyla aynı oranda (4/5) durur ki fotoğraf gelince yerleşim kaymasın */
  .cellar__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
</style>
