---
import Base from '../layouts/Base.astro';
import AgeGate from '../components/AgeGate.astro';
import Header from '../components/Header.astro';
import Descent from '../components/Descent.astro';
import Hero from '../components/Hero.astro';
import HeritageSection from '../components/HeritageSection.astro';
import VineyardSection from '../components/VineyardSection.astro';
import ProductionSection from '../components/ProductionSection.astro';
import AwardsSection from '../components/AwardsSection.astro';
import VisitSection from '../components/VisitSection.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { tr } from '../content/site';
---

<Base title={tr.meta.title} description={tr.meta.description} lang="tr">
  <AgeGate />
  <Header />
  <Descent />

  <main>
    <Hero />

    <!-- Miras / 1943 — koyu bölüm, arşiv bandı + portre köprüsü -->
    <HeritageSection />

    <!-- Bağcılık — açık bölüm, harita + üzüm kartları -->
    <VineyardSection />

    <!-- Üretim — koyu bölüm, önolog portresi + çelik tank bandı -->
    <ProductionSection />

    <!-- Ödüller — açık bölüm, kurumsal-nesnel liste -->
    <AwardsSection />

    <!-- Ziyaret — taş (tuff) zemin, nesnel ziyaret bilgisi -->
    <VisitSection />

    <!-- İletişim — dev şehir başlığı + bilgi listesi ve harita -->
    <Contact />
  </main>

  <Footer />
</Base>

<script>
  // Scroll reveal — bölüm içerikleri ekrana girdikçe yumuşakça belirir.
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll('.reveal');

  if (prefersReduced) {
    items.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.18 }
    );
    items.forEach((el) => io.observe(el));
  }
</script>
