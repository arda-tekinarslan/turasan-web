---
import Base from '../layouts/Base.astro';
import AgeGate from '../components/AgeGate.astro';
import Header from '../components/Header.astro';
import Descent from '../components/Descent.astro';
import Hero from '../components/Hero.astro';
import HeritageSection from '../components/HeritageSection.astro';
import VineyardSection from '../components/VineyardSection.astro';
import ProductionSection from '../components/ProductionSection.astro';
import AwardsSection from '../components/AwardsSection.astro';
import CellarSection from '../components/CellarSection.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { dilBul, icerik } from '../lib/dil';
const c = icerik(dilBul(Astro.url));
---

<Base title={c.meta.title} description={c.meta.description}>
  <AgeGate />
  <Header />
  <Descent />

  <main>
    <Hero />

    <!-- Miras / 1943 — koyu bölüm, arşiv bandı + portre köprüsü -->
    <HeritageSection />

    <!-- Bağcılık — açık bölüm, harita + üzüm kartları -->
    <VineyardSection />

    <!-- Üretim — koyu bölüm, önolog portresi + çelik tank bandı -->
    <ProductionSection />

    <!-- Ödüller — açık bölüm, kurumsal-nesnel liste -->
    <AwardsSection />

    <!-- Mahzen — taş (tuff) zemin, kaya mahzen ve dinlendirme -->
    <CellarSection />

    <!-- İletişim — dev şehir başlığı + bilgi listesi ve harita -->
    <Contact />
  </main>

  <Footer />
</Base>

