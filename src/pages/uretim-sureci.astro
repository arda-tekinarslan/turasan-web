---
import SubPage from '../layouts/SubPage.astro';
import { tr } from '../content/site';
const t = tr.pages.process;
---

<SubPage
  title={`${t.title} — Turasan Şarapçılık`}
  description="Turasan'da üretim süreci: hasattan şişelemeye tanımlı aşamalar; kaya mahzen ve çelik tank bir arada."
  overline={t.overline}
  heading={t.title}
  lead={t.lead}
>
  <ol class="steps">
    {t.steps.map((s, i) => (
      <li class="steps__item reveal" style={`transition-delay: ${i * 80}ms;`}>
        <span class="steps__num display" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h2 class="display steps__title">{s.title}</h2>
          <p class="muted steps__body">{s.body}</p>
        </div>
      </li>
    ))}
  </ol>
</SubPage>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(32px, 5vh, 48px);
    max-width: 62ch;
  }

  .steps__item {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 24px;
    padding-top: clamp(24px, 3.5vh, 36px);
    border-top: 1px solid color-mix(in srgb, var(--color-on-light) 14%, transparent);
  }

  .steps__num {
    font-size: 28px;
    color: var(--color-garnet);
    line-height: 1.2;
  }

  .steps__title {
    font-size: clamp(20px, 2.4vw, 28px);
    margin: 0 0 0.4em;
  }

  .steps__body { margin: 0; }
</style>
