---
import SubPage from '../layouts/SubPage.astro';
import { tr } from '../content/site';
const t = tr.pages.grapes;
---

<SubPage
  title={`${t.title} — Turasan Şarapçılık`}
  description="Kapadokya'da yetiştirilen üzümler: Emir, Narince, Kalecik Karası ve Öküzgözü hakkında nesnel bilgi."
  overline={t.overline}
  heading={t.title}
  lead={t.lead}
>
  <div class="grape-details">
    {t.details.map((g, i) => (
      <article class="grape-detail reveal" style={`transition-delay: ${i * 80}ms;`}>
        <header class="grape-detail__head">
          <h2 class="display grape-detail__name">{g.name}</h2>
          <span class="grape-detail__type">{g.type}</span>
        </header>
        <p class="muted grape-detail__region">{g.region}</p>
        <div class="prose-block grape-detail__body">
          {g.body.map((p) => <p>{p}</p>)}
        </div>
      </article>
    ))}
  </div>
</SubPage>

<style>
  .grape-details {
    display: grid;
    gap: clamp(40px, 6vh, 64px);
  }

  .grape-detail {
    padding-top: clamp(28px, 4vh, 40px);
    border-top: 1px solid color-mix(in srgb, var(--color-on-light) 14%, transparent);
    max-width: 62ch;
  }

  .grape-detail__head {
    display: flex;
    align-items: baseline;
    gap: 18px;
  }

  .grape-detail__name {
    font-size: clamp(26px, 3.4vw, 40px);
    margin: 0;
  }

  .grape-detail__type {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-garnet);
  }

  .grape-detail__region {
    margin: 8px 0 0;
    font-size: 14px;
  }

  .grape-detail__body {
    margin-top: 1em;
    color: var(--color-on-light-mut);
  }
</style>
