---
/**
 * Eski /uzumler adresinden /uzumler-ve-bolgeler sayfasına kalıcı yönlendirme.
 * Dışarıda paylaşılmış eski linkler kırılmasın diye tutulur.
 * withBase sayesinde taban yolu değişse de hedef doğru kalır.
 */
import { withBase } from '../lib/url';

const target = withBase('/uzumler-ve-bolgeler');
const canonical = new URL(target, Astro.site);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <title>Yönlendiriliyor — Üzümler ve Bölgeler</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a href={target}>Üzümler ve Bölgeler sayfasına yönlendiriliyorsunuz…</a>
  </body>
</html>
