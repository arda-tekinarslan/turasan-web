---
/**
 * Ödül arşivi — kurumsal-nesnel liste. Kupa/madalya grafiği ve övgü dili yok;
 * nihai içerik hukuk danışmanı onayından geçmelidir.
 */
import SubPage from '../layouts/SubPage.astro';
import { tr } from '../content/site';
const t = tr.pages.awards;
---

<SubPage
  title={`${t.title} — Turasan Şarapçılık`}
  description="Turasan Şarapçılık'ın uluslararası yarışma sonuçları; yarışma, kategori ve yıl düzeyinde arşiv."
  overline={t.overline}
  heading={t.title}
  lead={t.lead}
>
  <div class="archive">
    {t.years.map((y, i) => (
      <section class="archive__year reveal" style={`transition-delay: ${i * 80}ms;`}>
        <h2 class="display archive__title">{y.year}</h2>
        <ul class="archive__list">
          {y.items.map((item) => (
            <li class="archive__item">{item}</li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</SubPage>

<style>
  .archive {
    display: grid;
    gap: clamp(40px, 6vh, 64px);
    max-width: 62ch;
  }

  .archive__year {
    padding-top: clamp(24px, 3.5vh, 36px);
    border-top: 1px solid color-mix(in srgb, var(--color-on-light) 14%, transparent);
  }

  .archive__title {
    font-size: clamp(26px, 3.4vw, 40px);
    margin: 0 0 0.6em;
  }

  .archive__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .archive__item {
    padding: 12px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-on-light) 10%, transparent);
    font-size: 15px;
    color: var(--color-on-light-mut);
  }
</style>
