---
import SubPage from '../layouts/SubPage.astro';
import Foto from '../components/Foto.astro';
import { dilBul, icerik } from '../lib/dil';
const c = icerik(dilBul(Astro.url));
const t = c.pages.heritage;
---

<SubPage
  title={`${t.title} — ${c.ui.brand}`}
  description={t.description}
  overline={t.overline}
  heading={t.title}
  lead={t.lead}
>
  <div class="timeline">
    {t.sections.map((s, i) => (
      <article class="timeline__item reveal" style={`transition-delay: ${i * 80}ms;`}>
        <div class="timeline__media">
          <Foto src={s.image} alt={s.alt} label={s.phLabel} oran="portrait" />
        </div>
        <div>
          <h2 class="display timeline__title">{s.title}</h2>
          <div class="prose-block lead muted">
            {s.body.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</SubPage>

<style>
  .timeline {
    display: grid;
    gap: clamp(56px, 9vh, 96px);
  }

  .timeline__item {
    display: grid;
    grid-template-columns: minmax(200px, 320px) 1fr;
    gap: var(--split-gap);
    align-items: start;
  }

  /* Dönüşümlü hiza — editoryal ritim. Fotoğraf sağa geçerken sütun
     genişlikleri de yer değiştirmeli; yalnızca order verilirse fotoğraf
     geniş (1fr) sütuna düşer ve diğer kuşaklardan büyük görünür. */
  .timeline__item:nth-child(even) {
    grid-template-columns: 1fr minmax(200px, 320px);
  }
  .timeline__item:nth-child(even) .timeline__media { order: 2; }

  .timeline__title {
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.1;
    margin: 0 0 0.6em;
  }

  @media (max-width: 760px) {
    .timeline__item,
    .timeline__item:nth-child(even) { grid-template-columns: 1fr; }
    .timeline__item:nth-child(even) .timeline__media { order: 0; }
  }
</style>
