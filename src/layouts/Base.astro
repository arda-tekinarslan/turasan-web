---
import '../styles/global.css';
import { withBase } from '../lib/url';
import { YAS_ONAY_KEY } from '../lib/yas-kapisi';
import { dilBul, karsiDilYolu } from '../lib/dil';
import YuklemeEkrani from '../components/YuklemeEkrani.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const lang = dilBul(Astro.url);

// hreflang: sayfanın iki dil sürümü birbirini gösterir; varsayılan Türkçe
const burasi = Astro.url.pathname;
const trYol = lang === 'tr' ? burasi : karsiDilYolu(Astro.url);
const enYol = lang === 'en' ? burasi : karsiDilYolu(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="tr" href={new URL(trYol, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enYol, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(trYol, Astro.site)} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500&family=Charis+SIL:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />

    <!--
      Yaş kapısının bir kare boyunca görünmesini engeller.
      AgeGate'in kendi script'i modül olduğu için ertelenir (defer) ve
      HTML çizildikten sonra çalışır; sayfalar arası gezinmede kapı kısa
      süre parlıyordu. Bu satır <head> içinde senkron çalışır, işaret
      <html> üzerine daha ilk boyamadan önce düşer.
      is:inline şart: Astro aksi halde bunu da modüle çevirip ertelerdi.
    -->
    <script is:inline define:vars={{ yasKey: YAS_ONAY_KEY }}>
      try {
        if (sessionStorage.getItem(yasKey) === '1') {
          document.documentElement.classList.add('yas-onayli');
        }
      } catch (e) {
        /* sessionStorage kapalıysa kapı normal akışta gösterilir */
      }
    </script>
  </head>
  <body>
    <slot />

    <!--
      Yaş kapısı onayından sonra bir kez oynayan geçiş animasyonu.
      AgeGate ile aynı seviyede (ikisi de body çocuğu) ve onun altında
      (z-index 90 < 100). Her sayfa Base'den geçtiği için tek yerde durur.
    -->
    <YuklemeEkrani dolumSuresi={1600} />

    <script>
      // Derin bağlantı telafisi: yaş kapısı açıkken <body> kilitli olduğu için
      // tarayıcının hash kaydırması boşa düşebiliyor ve kapı kapandığında
      // yeniden denenmiyor. Giriş sırası bittiğinde hedefe konumlanırız.
      // (Harita bölgeleri gibi paylaşılan #anchor linkleri buna dayanıyor.)
      document.addEventListener(
        'yukleme:bitti',
        () => {
          if (!location.hash) return;
          let hedef = null;
          try {
            hedef = document.querySelector(location.hash);
          } catch {
            return; // hash geçerli bir seçici değil
          }
          hedef?.scrollIntoView({ behavior: 'auto', block: 'start' });
        },
        { once: true }
      );

      // Scroll reveal — .reveal öğeleri ekrana girdikçe yumuşakça belirir.
      // Tüm sayfalarda ortak olduğu için layout'ta yaşar.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('.reveal');

      if (prefersReduced) {
        items.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.18 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
